SELECT
    CAST(SUBSTR(date_operation, 5, 4) AS INT)                                      AS annee,
    COUNT(DISTINCT num_automate)                                                   AS nb_gab,
    SUM(CASE WHEN lib_ope IN ('Retrait', 'Autorisation-Retrait')
              AND CAST(montant_ope AS DOUBLE) > 0 THEN 1 ELSE 0 END)               AS total_retraits,
    SUM(CASE WHEN lib_ope = 'Retrait' AND CAST(montant_ope AS DOUBLE) > 0 THEN 1 ELSE 0 END)              AS total_retraits_cos,
    SUM(CASE WHEN lib_ope = 'Autorisation-Retrait' AND CAST(montant_ope AS DOUBLE) > 0 THEN 1 ELSE 0 END) AS total_retraits_horscos,
    ROUND(SUM(CASE WHEN lib_ope IN ('Retrait', 'Autorisation-Retrait')
                   AND CAST(montant_ope AS DOUBLE) > 0 THEN CAST(montant_ope AS DOUBLE) / 100 ELSE 0 END), 0) AS montant_total,
    SUM(CASE WHEN lib_ope = 'Capture de Carte' THEN 1 ELSE 0 END)                  AS total_captures,
    COUNT(*)                                                                       AS total_lignes_brutes
FROM ma_base.table_retraits
GROUP BY CAST(SUBSTR(date_operation, 5, 4) AS INT)
ORDER BY annee;
