
SELECT
    SUBSTR(date_transaction, 1, 6) AS mois,
    COUNT(*) AS nb_autorisees,
    SUM(CASE WHEN date_comp IS NULL OR TRIM(date_comp) = '' THEN 1 ELSE 0 END) AS nb_date_comp_vide,
    SUM(CASE WHEN <MONTANT_COMP> IS NULL OR <MONTANT_COMP> = 0 THEN 1 ELSE 0 END) AS nb_montant_comp_vide
FROM <TABLE_MONETIQUE>
WHERE type_ope = 'retrait'
  AND TRIM(ref_aut) <> ''
  AND SUBSTR(date_transaction, 1, 6) >= '202504'
GROUP BY SUBSTR(date_transaction, 1, 6)
ORDER BY mois
;




