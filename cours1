SELECT
    num_automate,
    date_operation,
    heure_operation,
    num_carte,
    montant_euros,
    type_reseau,
    code_carte_privative,

    CASE
        WHEN est_postepargne = 1 THEN 'Postepargne'
        WHEN est_porteur_lbp = 1 THEN 'Carte LBP (hors postepargne)'
        ELSE 'Autre'
    END AS type_carte,

    -- 0 = uniquement nos GAB, 1 = peut retirer dans les GAB d'autres banques
    CASE
        WHEN est_postepargne = 1 THEN 0
        WHEN est_porteur_lbp = 1 THEN 1
        ELSE NULL
    END AS flag_retrait_autres_gab

FROM (
    SELECT
        num_automate,
        date_operation,
        heure_operation,
        num_carte,
        CAST(montant_ope AS DOUBLE) / 100 AS montant_euros,
        type_reseau,
        code_carte_privative,
        CASE WHEN code_carte_privative IN ('CPE', 'C24') THEN 1 ELSE 0 END AS est_postepargne,
        CASE WHEN SUBSTR(num_carte, 1, 6) IN ('<BIN_1>', '<BIN_2>', '<BIN_3>', '<BIN_4>') THEN 1 ELSE 0 END AS est_porteur_lbp
    FROM <TABLE_RETRAIT>
    WHERE num_automate = '<NUM_GAB>'
      AND SUBSTR(date_operation, 5, 4) = '2026'
      AND lib_ope IN ('Retrait', 'Autorisation-Retrait')
) t

WHERE est_postepargne = 1 OR est_porteur_lbp = 1
ORDER BY date_operation, heure_operation
;
