def deriver_coefficient_variation_montant(
    df: pd.DataFrame,
    colonne_stddev: str = "ret_montant_stddev",
    colonne_moyenne: str = "ret_montant_moyen",
) -> pd.DataFrame:
    """Derive un coefficient de variation des montants retires (regularite d'usage)."""
    df = df.copy()
    moyenne_non_nulle = df[colonne_moyenne].replace(0, np.nan)
    cv = df[colonne_stddev] / moyenne_non_nulle
    df["cv_montant_retrait"] = cv.fillna(0).clip(lower=0)
    return df
