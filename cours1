# 3. Liste complète des modèles scikit-learn installés (cluster, anomalies, réduction)
print("\n=== TOUS LES ESTIMATEURS SCIKIT-LEARN UTILES ===")
try:
    from sklearn.utils import all_estimators            # sklearn >= 0.22
except ImportError:
    from sklearn.utils.testing import all_estimators    # sklearn 0.21
MODULES = ("sklearn.cluster", "sklearn.mixture", "sklearn.ensemble._iforest",
           "sklearn.ensemble.iforest", "sklearn.neighbors", "sklearn.covariance",
           "sklearn.svm", "sklearn.decomposition", "sklearn.manifold")
for nom, cls in sorted(all_estimators(), key=lambda x: (x[1].__module__, x[0])):
    if cls.__module__.startswith(MODULES):
        print("  {:<40} {}".format(cls.__module__, nom))

# 4. Ressources de la machine (le kernel meurt-il par manque de mémoire ?)
print("\n=== RESSOURCES ===")
print("  Coeurs CPU :", os.cpu_count())
try:
    import psutil
    mem = psutil.virtual_memory()
    print("  Mémoire    : {:.1f} Go au total, {:.1f} Go libres".format(mem.total / 1e9, mem.available / 1e9))
except ImportError:
    try:
        with open("/proc/meminfo") as f:
            infos = dict(l.split(":") for l in f.read().splitlines()[:3])
        print("  Mémoire    :", {k: v.strip() for k, v in infos.items()})
    except Exception:
        print("  Mémoire    : non mesurable ici")

