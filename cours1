SELECT
    SUBSTR(date_transaction, 1, 6) AS mois,
    num_dab,

    COUNT(*) AS nb_autorisations,

    -- Indicateur 1 : pas de date de compensation
    SUM(CASE WHEN date_comp IS NULL OR TRIM(CAST(date_comp AS STRING)) = '' THEN 1 ELSE 0 END) AS nb_date_comp_vide,

    -- Indicateur 2 : pas de montant compense
    SUM(CASE WHEN <MONTANT_COMP> IS NULL OR CAST(<MONTANT_COMP> AS DOUBLE) = 0 THEN 1 ELSE 0 END) AS nb_montant_comp_vide,

    -- Metrique demandee : non compensee si date OU montant de compensation absent
    SUM(CASE
            WHEN date_comp IS NULL OR TRIM(CAST(date_comp AS STRING)) = ''
              OR <MONTANT_COMP> IS NULL OR CAST(<MONTANT_COMP> AS DOUBLE) = 0
            THEN 1 ELSE 0
        END) AS nb_non_compensees,

    ROUND(100 * SUM(CASE
            WHEN date_comp IS NULL OR TRIM(CAST(date_comp AS STRING)) = ''
              OR <MONTANT_COMP> IS NULL OR CAST(<MONTANT_COMP> AS DOUBLE) = 0
            THEN 1 ELSE 0
        END) / COUNT(*), 2) AS taux_non_compensees_pct,

    -- Bonus : compensees, mais pour un montant inferieur au montant autorise
    SUM(CASE
            WHEN CAST(<MONTANT_COMP> AS DOUBLE) > 0
             AND CAST(<MONTANT_COMP> AS DOUBLE) < CAST(<MONTANT_TRANSACTION> AS DOUBLE)
            THEN 1 ELSE 0
        END) AS nb_compensations_partielles

FROM <TABLE_MONETIQUE>
WHERE type_ope = 'retrait'
  AND ref_aut IS NOT NULL
  AND TRIM(ref_aut) <> ''
  AND SUBSTR(date_transaction, 1, 6) BETWEEN '202504' AND '202609'
GROUP BY SUBSTR(date_transaction, 1, 6), num_dab
ORDER BY mois, num_dab
;
