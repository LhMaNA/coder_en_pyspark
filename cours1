-- ============================================================================
-- RECETTE 1/3 : extraire les BIN distincts (6 et 8 chiffres) de la table
-- de retraits (400M lignes). Le but : ne garder que les valeurs UNIQUES
-- de bin_clean, pour ne faire le matching couteux (BIN -> pays) qu'une
-- seule fois par valeur distincte, pas 400 millions de fois.
-- ============================================================================

SELECT DISTINCT
    CASE WHEN SUBSTR(num_carte, 7, 2) = 'XX' THEN SUBSTR(num_carte, 1, 6) ELSE SUBSTR(num_carte, 1, 8) END AS bin_clean,
    CASE WHEN SUBSTR(num_carte, 7, 2) = 'XX' THEN 6 ELSE 8 END AS bin_type

FROM `dss_fallback_lbp_dp`.`reporting_t_dlk_mon_nf2_ope_retrait_v1`
;



-------------------------------------------------------------------------------------


-- ============================================================================
-- RECETTE 2/3 : matcher chaque BIN distinct (sortie de la recette 1,
-- quelques dizaines/centaines de milliers de lignes seulement) au pays,
-- via la table de plages BIN. BIN8 en priorite, repli automatique sur
-- BIN6 si pas de match en 8 chiffres.
-- C'est ICI que se fait le matching couteux (jointure par intervalle) -
-- mais sur un volume tres reduit, donc rapide.
-- ============================================================================

SELECT
    bd.bin_clean,
    bd.bin_type,
    COALESCE(m8.pays, m6.pays) AS pays,
    CASE
        WHEN COALESCE(m8.pays, m6.pays) IS NULL THEN NULL
        WHEN COALESCE(m8.pays, m6.pays) = 'FRA' THEN 0
        ELSE 1
    END AS flag_etranger

FROM `dss_fallback_lbp_dp`.`bin_distincts` bd

-- Jointure BIN8 : match precis, uniquement si bin_type=8
LEFT JOIN (
    SELECT
        CAST(SUBSTR(pi_trmin, 1, 8) AS BIGINT) AS bin8_min,
        CAST(SUBSTR(pi_trmax, 1, 8) AS BIGINT) AS bin8_max,
        UPPER(TRIM(pi_cdpays)) AS pays
    FROM `dss_fallback_lbp_dp`.`t_lbp_mon_bin8_h`
    WHERE pi_daeffet <= '2026-01-01' AND pi_dafin > '2025-12-31'
      AND pi_trmin IS NOT NULL AND pi_trmax IS NOT NULL
) m8
    ON bd.bin_type = 8
   AND CAST(bd.bin_clean AS BIGINT) BETWEEN m8.bin8_min AND m8.bin8_max

-- Jointure BIN6 : repli, applicable a tous (bin_type=6 direct, bin_type=8 en secours via les 6 premiers chiffres)
LEFT JOIN (
    SELECT
        CAST(SUBSTR(pi_trmin, 1, 6) AS BIGINT) AS bin6_min,
        CAST(SUBSTR(pi_trmax, 1, 6) AS BIGINT) AS bin6_max,
        UPPER(TRIM(pi_cdpays)) AS pays
    FROM `dss_fallback_lbp_dp`.`t_lbp_mon_bin8_h`
    WHERE pi_daeffet <= '2026-01-01' AND pi_dafin > '2025-12-31'
      AND pi_trmin IS NOT NULL AND pi_trmax IS NOT NULL
) m6
    ON CAST(SUBSTR(bd.bin_clean, 1, 6) AS BIGINT) BETWEEN m6.bin6_min AND m6.bin6_max
;



-------------------------------------------------------------------------------------------


-- ============================================================================
-- RECETTE 3/3 : rejoindre le resultat BIN -> pays (sortie de la recette 2,
-- petit volume) a la table complete de 400M lignes.
-- Jointure PAR EGALITE simple (bin_clean = bin_clean), PAS un BETWEEN -
-- c'est ce qui la rend rapide meme a 400M lignes : Hive peut faire un
-- hash join efficace sur une egalite, contrairement a une comparaison
-- d'intervalle.
-- ============================================================================

SELECT
    r.*,
    CASE WHEN SUBSTR(r.num_carte, 7, 2) = 'XX' THEN SUBSTR(r.num_carte, 1, 6) ELSE SUBSTR(r.num_carte, 1, 8) END AS bin_clean,
    CASE WHEN SUBSTR(r.num_carte, 7, 2) = 'XX' THEN 6 ELSE 8 END AS bin_type,
    bp.pays,
    bp.flag_etranger

FROM `dss_fallback_lbp_dp`.`reporting_t_dlk_mon_nf2_ope_retrait_v1` r

LEFT JOIN `dss_fallback_lbp_dp`.`bin_distincts_pays` bp
    ON (CASE WHEN SUBSTR(r.num_carte, 7, 2) = 'XX' THEN SUBSTR(r.num_carte, 1, 6) ELSE SUBSTR(r.num_carte, 1, 8) END) = bp.bin_clean
   AND (CASE WHEN SUBSTR(r.num_carte, 7, 2) = 'XX' THEN 6 ELSE 8 END) = bp.bin_type
;
