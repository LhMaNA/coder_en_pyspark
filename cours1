---

**2. Par fenêtre de 5 secondes**
```sql
SELECT
    SUBSTR(CAST(timestamp_postage_mq AS STRING), 1, 16) AS heure_minute,
    (CAST(SUBSTR(CAST(timestamp_postage_mq AS STRING), 18, 2) AS INT) / 5) * 5 AS seconde_5s,
    COUNT(*) AS tps_5s
FROM nom_de_ta_table
WHERE circuit = 'RVM'
  AND timestamp_postage_mq >= '2025-10-09'
GROUP BY
    SUBSTR(CAST(timestamp_postage_mq AS STRING), 1, 16),
    (CAST(SUBSTR(CAST(timestamp_postage_mq AS STRING), 18, 2) AS INT) / 5) * 5
ORDER BY heure_minute, seconde_5s
```

---

**3. Par heure**
```sql
SELECT
    CAST(timestamp_postage_mq AS DATE)                   AS date,
    HOUR(timestamp_postage_mq)                           AS heure,
    COUNT(*)                                             AS nb_transactions,
    MAX(tps_sec)                                         AS tps_max,
    PERCENTILE_APPROX(tps_sec, 0.99)                     AS tps_p99,
    PERCENTILE_APPROX(tps_sec, 0.95)                     AS tps_p95,
    AVG(tps_sec)                                         AS tps_moyen
FROM (
    SELECT
        timestamp_postage_mq,
        COUNT(*) AS tps_sec
    FROM nom_de_ta_table
    WHERE circuit = 'RVM'
      AND timestamp_postage_mq >= '2025-10-09'
    GROUP BY SUBSTR(CAST(timestamp_postage_mq AS STRING), 1, 19), timestamp_postage_mq
) t
GROUP BY
    CAST(timestamp_postage_mq AS DATE),
    HOUR(timestamp_postage_mq)
ORDER BY date, heure
```

---

**4. Par année**
```sql
SELECT
    YEAR(timestamp_postage_mq)                           AS annee,
    COUNT(*)                                             AS nb_transactions,
    MAX(tps_sec)                                         AS tps_max,
    PERCENTILE_APPROX(tps_sec, 0.99)                     AS tps_p99,
    PERCENTILE_APPROX(tps_sec, 0.95)                     AS tps_p95,
    AVG(tps_sec)                                         AS tps_moyen
FROM (
    SELECT
        timestamp_postage_mq,
        COUNT(*) AS tps_sec
    FROM nom_de_ta_table
    WHERE circuit = 'RVM'
    GROUP BY SUBSTR(CAST(timestamp_postage_mq AS STRING), 1, 19), timestamp_postage_mq
) t
GROUP BY YEAR(timestamp_postage_mq)
ORDER BY annee
```

