SELECT
    CASE
        WHEN code_carte_privative IN ('CPE', 'C24') THEN 'Carte postepargne'
        WHEN code_carte_privative = 'COS'           THEN 'Carte COS'
        ELSE 'Autre carte'
    END AS type_carte,
    COUNT(*) AS nb_retraits,
    ROUND(SUM(CAST(montant_ope AS DOUBLE) / 100), 0) AS montant_total_euros,
    ROUND(AVG(CAST(montant_ope AS DOUBLE) / 100), 1) AS montant_moyen_euros
FROM <TABLE_RETRAIT>
WHERE (type_reseau = '11' OR code_carte_privative = 'COS')
  AND lib_ope IN ('Retrait', 'Autorisation-Retrait')
  AND SUBSTR(date_operation, 5, 4) = '2026'
  AND SUBSTR(date_operation, 3, 2) BETWEEN '01' AND '06'
GROUP BY
    CASE
        WHEN code_carte_privative IN ('CPE', 'C24') THEN 'Carte postepargne'
        WHEN code_carte_privative = 'COS'           THEN 'Carte COS'
        ELSE 'Autre carte'
    END
;


