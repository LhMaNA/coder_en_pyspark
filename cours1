def evaluer_pouvoir_discriminant_features(
    X: pd.DataFrame, labels: np.ndarray,
) -> pd.DataFrame:
    """Mesure la capacite reelle de chaque feature a separer les clusters trouves."""
    labels = np.asarray(labels)
    variance_totale = X.var(ddof=0)

    moyennes_par_cluster = X.groupby(labels).mean()
    effectifs_par_cluster = pd.Series(labels).value_counts().sort_index()
    moyenne_globale = X.mean()

    variance_inter = pd.Series(0.0, index=X.columns)
    for cluster_id in moyennes_par_cluster.index:
        ecart = moyennes_par_cluster.loc[cluster_id] - moyenne_globale
        variance_inter += effectifs_par_cluster.loc[cluster_id] * (ecart ** 2)
    variance_inter /= len(X)

    variance_intra = variance_totale - variance_inter
    variance_intra = variance_intra.clip(lower=1e-12)

    ratio = variance_inter / variance_intra

    resultats = pd.DataFrame({
        "feature": X.columns,
        "variance_inter_cluster": variance_inter.values.round(4),
        "variance_intra_cluster": variance_intra.values.round(4),
        "ratio_discriminant": ratio.values.round(4),
    }).sort_values("ratio_discriminant", ascending=False).reset_index(drop=True)

    seuil_faible = resultats["ratio_discriminant"].quantile(0.25)
    resultats["feature_faible"] = resultats["ratio_discriminant"] <= seuil_faible

    return resultats


def identifier_paires_indiscernables(
    X: pd.DataFrame, labels: np.ndarray, seuil_ecart_reduit: float = 0.5,
) -> pd.DataFrame:
    """Pour chaque paire de clusters, identifie les features qui ne les distinguent pas."""
    labels = np.asarray(labels)
    moyennes = X.groupby(labels).mean()
    ecarts_types_globaux = X.std(ddof=0)
    clusters = sorted(set(labels))

    resultats = []
    for i in range(len(clusters)):
        for j in range(i + 1, len(clusters)):
            c1, c2 = clusters[i], clusters[j]
            ecart_normalise = (moyennes.loc[c1] - moyennes.loc[c2]).abs() / ecarts_types_globaux
            indiscernables = ecart_normalise[ecart_normalise < seuil_ecart_reduit].index.tolist()
            discriminantes = ecart_normalise[ecart_normalise >= seuil_ecart_reduit].sort_values(
                ascending=False
            )
            resultats.append({
                "cluster_1": c1,
                "cluster_2": c2,
                "nb_features_indiscernables": len(indiscernables),
                "features_indiscernables": ", ".join(indiscernables) if indiscernables else "(aucune)",
                "feature_la_plus_discriminante": (
                    discriminantes.index[0] if len(discriminantes) else "(aucune)"
                ),
            })

    return pd.DataFrame(resultats).sort_values(
        "nb_features_indiscernables", ascending=False
    ).reset_index(drop=True)
