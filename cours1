    pct_zero = (df_clust[col] == 0).mean() * 100
    print(f"{col:35s} skew={skew:6.2f}  zeros={pct_zero:5.1f}%")
print()

print("=== CORRELATION ENTRE FEATURES (deja calcule ailleurs, rappel) ===")
print(df_clust[features_clustering_dispo].corr().round(2))
print()

