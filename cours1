SELECT
    num_automate,
    date_operation,
    CAST(montant_ope AS DOUBLE) / 100 AS montant_euros,
    code_carte_privative,

    CASE
        WHEN code_carte_privative IN ('CPE', 'C24') THEN 'Postepargne'
        ELSE 'Autre carte LBP'
    END AS carte_utilisee,

    -- Deduit du type de carte, a confirmer avec le demandeur
    CASE
        WHEN code_carte_privative IN ('CPE', 'C24') THEN 'Compte epargne'
        ELSE 'CCP'
    END AS compte_debite_deduit

FROM <TABLE_RETRAIT>
WHERE type_reseau = '11'   -- retraits COS
  AND lib_ope IN ('Retrait', 'Autorisation-Retrait')
;
