**Par jour** (sans PERCENTILE_APPROX) :
```sql
SELECT
    date,
    COUNT(*)                                              AS nb_secondes,
    MAX(tps_sec)                                          AS tps_max,
    AVG(tps_sec)                                          AS tps_moyen,
    MIN(tps_sec)                                          AS tps_min,
    SUM(CASE WHEN tps_sec > 50 THEN 1 ELSE 0 END)         AS nb_depassements
FROM (
    SELECT
        CAST(timestamp_postage_mq AS DATE) AS date,
        SUBSTR(CAST(timestamp_postage_mq AS STRING), 1, 19) AS ts_sec,
        COUNT(*) AS tps_sec
    FROM nom_de_ta_table
    WHERE circuit = 'RVM'
      AND timestamp_postage_mq >= '2025-10-09'
    GROUP BY
        CAST(timestamp_postage_mq AS DATE),
        SUBSTR(CAST(timestamp_postage_mq AS STRING), 1, 19)
) t
GROUP BY date
ORDER BY date
```

